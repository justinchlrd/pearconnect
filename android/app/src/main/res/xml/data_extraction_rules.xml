<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé ni transféré : les réglages contiennent des jetons. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
