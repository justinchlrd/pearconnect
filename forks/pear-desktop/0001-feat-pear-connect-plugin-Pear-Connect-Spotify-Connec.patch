diff --git a/src/plugins/pear-connect/backend.ts b/src/plugins/pear-connect/backend.ts
new file mode 100644
index 0000000..e2cbf94
--- /dev/null
+++ b/src/plugins/pear-connect/backend.ts
@@ -0,0 +1,289 @@
+/*
+ * Pear Connect, processus principal : relie ce Pear Desktop au serveur Connect.
+ *  - publie l'état de lecture (titre, position, mix, file, volume) ;
+ *  - relève et exécute les commandes (long-poll) ;
+ *  - relaie le flux temps réel du serveur à la page (barre « Lecture sur … »).
+ */
+import { getSongControls } from '@/providers/song-controls';
+import { registerCallback, type SongInfo } from '@/providers/song-info';
+import { createBackend } from '@/utils';
+
+import { ConnectClient, ConnectError } from './client';
+import {
+  type ActionResult,
+  type Command,
+  type PlaybackState,
+  type Snapshot,
+  type UiAction,
+  cleanPlaylistId,
+  stateChanged,
+} from './protocol';
+
+import type { PearConnectConfig } from './config';
+import type { BackendContext } from '@/types/contexts';
+
+/** État de lecture lu dans la page (positions en secondes). */
+export interface LocalReport {
+  videoId: string;
+  /** Contexte de lecture lu dans l'adresse de la page (…&list=RD…) */
+  playlistId: string;
+  title: string;
+  artist: string;
+  position: number;
+  duration: number;
+  paused: boolean;
+  volume: number | null;
+  upcoming: string[];
+  queue: PlaybackState['queue'];
+}
+
+const PUBLISH_EVERY = 2_000;
+const HEARTBEAT = 15_000;
+const LONG_POLL = 20;
+const LOG = '[Pear Connect]';
+
+const sleep = (ms: number, signal: AbortSignal) =>
+  new Promise<void>((resolve) => {
+    const t = setTimeout(resolve, ms);
+    signal.addEventListener('abort', () => {
+      clearTimeout(t);
+      resolve();
+    });
+  });
+
+type Props = {
+  ctx?: BackendContext<PearConnectConfig>;
+  client?: ConnectClient;
+  config?: PearConnectConfig;
+  abort?: AbortController;
+  song?: SongInfo;
+  local?: LocalReport;
+  localAt: number;
+  published: PlaybackState | null | undefined;
+  publishedAt: number;
+  snapshot?: Snapshot;
+  status: string;
+  callbackRegistered: boolean;
+  run(config: PearConnectConfig): void;
+  halt(): void;
+  currentState(): PlaybackState | null;
+  publishLoop(signal: AbortSignal): Promise<void>;
+  commandLoop(signal: AbortSignal): Promise<void>;
+  eventsLoop(signal: AbortSignal): Promise<void>;
+  execute(cmd: Command): void;
+  action(action: UiAction): Promise<ActionResult>;
+  pushSnapshot(): void;
+  setStatus(status: string): void;
+};
+
+export const backend = createBackend<Props, PearConnectConfig>({
+  localAt: 0,
+  published: undefined,
+  publishedAt: 0,
+  status: 'désactivé',
+  callbackRegistered: false,
+
+  async start(ctx) {
+    this.ctx = ctx;
+    if (!this.callbackRegistered) {
+      // pas de désinscription possible : on filtre selon this.abort
+      registerCallback((info) => {
+        this.song = info;
+      });
+      this.callbackRegistered = true;
+    }
+    ctx.ipc.on('pear-connect:local', (report: LocalReport) => {
+      this.local = report;
+      this.localAt = Date.now();
+    });
+    ctx.ipc.on('pear-connect:ready', () => this.pushSnapshot());
+    ctx.ipc.handle('pear-connect:action', (action: UiAction) =>
+      this.action(action),
+    );
+    this.run(await ctx.getConfig());
+  },
+
+  stop() {
+    this.halt();
+    this.ctx?.ipc.removeHandler('pear-connect:action');
+  },
+
+  onConfigChange(config) {
+    this.halt();
+    this.run(config);
+  },
+
+  run(config) {
+    this.config = config;
+    if (!config.server || !config.token || !config.device) {
+      this.setStatus('à configurer (menu Plugins › Pear Connect)');
+      return;
+    }
+    try {
+      this.client = new ConnectClient(config);
+    } catch (e) {
+      this.setStatus(`configuration invalide : ${(e as Error).message}`);
+      return;
+    }
+    const abort = new AbortController();
+    this.abort = abort;
+    this.published = undefined;
+    this.publishLoop(abort.signal);
+    this.commandLoop(abort.signal);
+    this.eventsLoop(abort.signal);
+    console.log(LOG, `appareil « ${config.device} » sur ${config.server}`);
+  },
+
+  halt() {
+    this.abort?.abort();
+    this.abort = undefined;
+    this.client = undefined;
+    this.snapshot = undefined;
+    this.pushSnapshot();
+  },
+
+  setStatus(status) {
+    if (status !== this.status) console.log(LOG, status);
+    this.status = status;
+  },
+
+  currentState() {
+    const local = this.local;
+    // la page n'a rien envoyé depuis 10 s : Pear est en train de (re)charger
+    if (!local || !local.videoId || Date.now() - this.localAt > 10_000)
+      return null;
+    const song = this.song?.videoId === local.videoId ? this.song : undefined;
+    return {
+      video_id: local.videoId,
+      position: local.position,
+      paused: local.paused,
+      duration: local.duration || song?.songDuration || 0,
+      title: song?.title || local.title,
+      artist: song?.artist || local.artist,
+      playlist_id:
+        cleanPlaylistId(local.playlistId) || cleanPlaylistId(song?.playlistId),
+      upcoming: local.upcoming,
+      queue: local.queue,
+      volume: local.volume,
+    };
+  },
+
+  async publishLoop(signal) {
+    let backoff = PUBLISH_EVERY;
+    while (!signal.aborted) {
+      try {
+        const state = this.currentState();
+        const now = Date.now();
+        if (
+          this.published === undefined ||
+          stateChanged(
+            this.published,
+            state,
+            (now - this.publishedAt) / 1000,
+          ) ||
+          now - this.publishedAt >= HEARTBEAT
+        ) {
+          await this.client!.putState(state);
+          this.published = state;
+          this.publishedAt = now;
+        }
+        this.setStatus('connecté');
+        backoff = PUBLISH_EVERY;
+      } catch (e) {
+        this.setStatus(`serveur : ${(e as Error).message}`);
+        backoff = Math.min(backoff * 2, 30_000);
+      }
+      await sleep(backoff, signal);
+    }
+  },
+
+  async commandLoop(signal) {
+    let failures = 0;
+    while (!signal.aborted) {
+      try {
+        const commands = await this.client!.takeCommands(LONG_POLL);
+        if (signal.aborted) return;
+        for (const cmd of commands) {
+          try {
+            this.execute(cmd);
+          } catch (e) {
+            console.warn(LOG, `commande ${cmd.type} en échec`, e);
+          }
+        }
+        if (commands.length) this.publishedAt = 0; // republier vite le nouvel état
+        failures = 0;
+      } catch (e) {
+        if (e instanceof ConnectError && e.status === 401)
+          this.setStatus('jeton refusé par le serveur');
+        failures += 1;
+        await sleep(
+          Math.min(2_000 << Math.min(failures - 1, 4), 30_000),
+          signal,
+        );
+      }
+    }
+  },
+
+  async eventsLoop(signal) {
+    while (!signal.aborted) {
+      try {
+        await this.client!.events((snap) => {
+          this.snapshot = snap;
+          this.pushSnapshot();
+        }, signal);
+      } catch {
+        /* coupure : on se reconnecte */
+      }
+      await sleep(3_000, signal);
+    }
+  },
+
+  pushSnapshot() {
+    const win = this.ctx?.window;
+    if (!win || win.isDestroyed()) return;
+    win.webContents.send('pear-connect:snapshot', {
+      snapshot: this.snapshot ?? null,
+      self: this.config?.device ?? '',
+      status: this.status,
+    });
+  },
+
+  execute(cmd) {
+    const win = this.ctx!.window;
+    if (cmd.type === 'enqueue') {
+      getSongControls(win).addSongToQueue(
+        cmd.video_id,
+        cmd.next ? 'INSERT_AFTER_CURRENT_VIDEO' : 'INSERT_AT_END',
+      );
+      return;
+    }
+    if (cmd.type === 'resume') {
+      console.log(
+        LOG,
+        `reprise de ${cmd.state.video_id} (${cmd.state.playlist_id || 'sans mix'})`,
+      );
+    }
+    // Le reste passe par l'API du lecteur dans la page : indépendant de la mise en page
+    // de YouTube Music (barre du lecteur classique ou nouveau mini-lecteur).
+    win.webContents.send('pear-connect:command', cmd);
+  },
+
+  async action(action) {
+    const client = this.client;
+    if (!client) return { ok: false, error: `Pear Connect ${this.status}` };
+    try {
+      if (action.op === 'hello') {
+        this.pushSnapshot();
+      } else if (action.op === 'transfer') {
+        await client.transfer(action.target);
+      } else if (action.op === 'control') {
+        const body: Record<string, unknown> = { ...action };
+        delete body.op;
+        await client.control(body);
+      }
+      return { ok: true };
+    } catch (e) {
+      return { ok: false, error: (e as Error).message };
+    }
+  },
+});
diff --git a/src/plugins/pear-connect/client.ts b/src/plugins/pear-connect/client.ts
new file mode 100644
index 0000000..29907e0
--- /dev/null
+++ b/src/plugins/pear-connect/client.ts
@@ -0,0 +1,230 @@
+/*
+ * Client HTTP(S) du serveur Connect, côté processus principal (Node).
+ * node:https plutôt que fetch : permet de faire confiance à l'autorité de
+ * certification du homelab sans l'installer dans Windows.
+ */
+import { readFileSync } from 'node:fs';
+import { request as httpRequest, type IncomingMessage } from 'node:http';
+import { request as httpsRequest } from 'node:https';
+
+import type { Command, PlaybackState, Snapshot } from './protocol';
+
+export class ConnectError extends Error {
+  constructor(
+    message: string,
+    readonly status = 0,
+  ) {
+    super(message);
+  }
+}
+
+export interface ClientOptions {
+  server: string;
+  token: string;
+  device: string;
+  caPath?: string;
+}
+
+const MAX_BODY = 2 * 1024 * 1024;
+
+export class ConnectClient {
+  private readonly base: URL;
+  private readonly ca?: Buffer;
+
+  constructor(private readonly opts: ClientOptions) {
+    this.base = new URL(opts.server.replace(/\/+$/, '') + '/');
+    if (this.base.protocol !== 'http:' && this.base.protocol !== 'https:') {
+      throw new ConnectError(
+        'adresse du serveur invalide (http:// ou https://)',
+      );
+    }
+    if (opts.caPath) this.ca = readFileSync(opts.caPath);
+  }
+
+  private open(
+    method: string,
+    path: string,
+    body: unknown,
+    timeoutMs: number,
+    onResponse: (res: IncomingMessage) => void,
+    onError: (err: Error) => void,
+    signal?: AbortSignal,
+  ) {
+    const url = new URL(path.replace(/^\//, ''), this.base);
+    const data =
+      body === undefined ? undefined : Buffer.from(JSON.stringify(body));
+    const req = (url.protocol === 'https:' ? httpsRequest : httpRequest)(
+      url,
+      {
+        method,
+        ca: this.ca,
+        signal,
+        headers: {
+          'Authorization': `Bearer ${this.opts.token}`,
+          ...(data
+            ? {
+                'Content-Type': 'application/json',
+                'Content-Length': data.length,
+              }
+            : method === 'GET'
+              ? {}
+              : { 'Content-Length': 0 }),
+        },
+      },
+      onResponse,
+    );
+    req.setTimeout(timeoutMs, () =>
+      req.destroy(new ConnectError('délai dépassé')),
+    );
+    req.on('error', onError);
+    req.end(data);
+  }
+
+  request<T>(
+    method: string,
+    path: string,
+    body?: unknown,
+    timeoutMs = 15_000,
+  ): Promise<T> {
+    return new Promise<T>((resolve, reject) => {
+      this.open(
+        method,
+        path,
+        body,
+        timeoutMs,
+        (res) => {
+          const chunks: Buffer[] = [];
+          let size = 0;
+          res.on('data', (c: Buffer) => {
+            size += c.length;
+            if (size > MAX_BODY)
+              res.destroy(new ConnectError('réponse trop grande'));
+            else chunks.push(c);
+          });
+          res.on('error', (e) => reject(e));
+          res.on('end', () => {
+            const text = Buffer.concat(chunks).toString('utf8');
+            const status = res.statusCode ?? 0;
+            if (status === 401)
+              return reject(
+                new ConnectError('jeton refusé par le serveur', 401),
+              );
+            if (status >= 400) {
+              let detail = '';
+              try {
+                detail = (JSON.parse(text) as { error?: string }).error ?? '';
+              } catch {
+                /* corps non JSON */
+              }
+              return reject(
+                new ConnectError(
+                  `HTTP ${status}${detail ? ` : ${detail}` : ''}`,
+                  status,
+                ),
+              );
+            }
+            try {
+              resolve((text ? JSON.parse(text) : null) as T);
+            } catch {
+              reject(new ConnectError('réponse illisible'));
+            }
+          });
+        },
+        (err) =>
+          reject(
+            err instanceof ConnectError
+              ? err
+              : new ConnectError(`serveur injoignable : ${err.message}`),
+          ),
+      );
+    });
+  }
+
+  private get node() {
+    return encodeURIComponent(this.opts.device);
+  }
+
+  putState(state: PlaybackState | null) {
+    return this.request('PUT', `/v1/devices/${this.node}/state`, {
+      kind: 'pear',
+      state,
+    });
+  }
+
+  async takeCommands(waitSeconds: number): Promise<Command[]> {
+    const res = await this.request<{ commands?: Command[] }>(
+      'POST',
+      `/v1/devices/${this.node}/commands/take?wait=${waitSeconds}`,
+      undefined,
+      (waitSeconds + 15) * 1000,
+    );
+    return res?.commands ?? [];
+  }
+
+  snapshot() {
+    return this.request<Snapshot>('GET', '/v1/snapshot');
+  }
+
+  transfer(target: string) {
+    return this.request('POST', '/v1/transfer', { target });
+  }
+
+  control(body: Record<string, unknown>) {
+    return this.request('POST', '/v1/control', body);
+  }
+
+  /** Flux temps réel /v1/events : appelle `onSnapshot` à chaque changement, jusqu'à coupure. */
+  events(
+    onSnapshot: (snap: Snapshot) => void,
+    signal: AbortSignal,
+  ): Promise<void> {
+    return new Promise<void>((resolve, reject) => {
+      this.open(
+        'GET',
+        '/v1/events',
+        undefined,
+        60_000, // le serveur envoie un keepalive toutes les 20 s
+        (res) => {
+          if ((res.statusCode ?? 0) >= 400) {
+            res.resume();
+            return reject(
+              new ConnectError(
+                `HTTP ${res.statusCode} sur /v1/events`,
+                res.statusCode,
+              ),
+            );
+          }
+          res.setEncoding('utf8');
+          let buffer = '';
+          res.on('data', (chunk: string) => {
+            buffer += chunk;
+            if (buffer.length > MAX_BODY) {
+              res.destroy(new ConnectError('flux trop volumineux'));
+              return;
+            }
+            let sep: number;
+            while ((sep = buffer.indexOf('\n\n')) >= 0) {
+              const block = buffer.slice(0, sep);
+              buffer = buffer.slice(sep + 2);
+              const data = block
+                .split('\n')
+                .filter((l) => l.startsWith('data:'))
+                .map((l) => l.slice(5).trimStart())
+                .join('\n');
+              if (!data) continue;
+              try {
+                onSnapshot(JSON.parse(data) as Snapshot);
+              } catch {
+                /* bloc illisible : ignoré */
+              }
+            }
+          });
+          res.on('end', () => resolve());
+          res.on('error', (e) => reject(e));
+        },
+        (err) => reject(err),
+        signal,
+      );
+    });
+  }
+}
